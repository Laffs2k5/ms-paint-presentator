<Project>
  <!-- Shared by every project under src/ (tests/ imports it too). -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Windows 10 2004 or later: the WinRT projection (Windows.Data.Pdf) -->
    <WindowsTfm>net9.0-windows10.0.19041.0</WindowsTfm>
  </PropertyGroup>
</Project>
